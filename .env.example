# ──────────────────────────────────────────────────────────────
# EMDAD — Environment Variables
# ──────────────────────────────────────────────────────────────
# 1. Copy this file and rename it to:  .env
# 2. Replace the value below with your real Anthropic API key
# 3. Get your key at: https://console.anthropic.com
# ──────────────────────────────────────────────────────────────

ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ── Admin panel credentials (server-side only) ──────────────────
# These have NO VITE_ prefix, so they are NEVER bundled into the
# browser. The server validates them and issues a signed session
# token; the password never reaches the client.
ADMIN_USER=admin

# PREFERRED: store a salted scrypt HASH instead of a plaintext password.
# Generate one with:  npm run hash-password -- "your-password"
# then paste the printed value here:
ADMIN_PASS_HASH=scrypt$16384$8$1$<salt>$<hash>

# FALLBACK (less secure): plaintext password. Only used if ADMIN_PASS_HASH
# is unset. Prefer the hash above for anything internet-facing.
# ADMIN_PASS=your-strong-password-here

# Secret used to sign admin session tokens. Set a long random value
# (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
# If left unset, a random secret is generated at startup and sessions
# reset whenever the server restarts.
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# ── Login rate limiting (optional) ──────────────────────────────
# Lock an IP after LOGIN_MAX_ATTEMPTS failed logins within LOGIN_WINDOW_MIN.
# Defaults: 5 attempts / 15 minutes. A successful login resets the counter.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_MIN=15

# ── HTTPS (optional) ────────────────────────────────────────────
# Point these at a TLS key/cert to serve the API over HTTPS. If unset, the
# server runs over HTTP (fine for local dev; localhost is a secure context).
# In production, TLS is usually terminated by a reverse proxy / host instead.
# Generate a local self-signed cert with:
#   openssl req -x509 -newkey rsa:2048 -nodes -keyout key.pem -out cert.pem -days 365 -subj "/CN=localhost"
# SSL_KEY_PATH=./key.pem
# SSL_CERT_PATH=./cert.pem
# If serving HTTPS, also update vite.config.js proxy target to https + secure:false.

# Set to "true" when running behind a TLS-terminating reverse proxy so the
# login rate limiter sees the real client IP (via X-Forwarded-For).
# TRUST_PROXY=true

# ── Production / hosting (see DEPLOYMENT.md) ────────────────────
# NODE_ENV=production
# PORT is injected by the host — do not set it manually.
# Put the SQLite DB and audit log on a persistent volume so they survive
# restarts/redeploys (e.g. a disk mounted at /data):
# DB_DIR=/data/db
# LOG_DIR=/data/logs
